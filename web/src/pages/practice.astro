---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070b14" />
    <meta name="description" content="Free AI English speaking practice. Talk out loud, hear a reply, and see your mistakes fixed right away." />
    <title>Practice | Hamsavani</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body data-view="practice" data-state="idle" data-tutor="Captain Hamsa">
    <header class="top">
      <div class="top-inner">
        <a class="brand" id="brand" href="/" aria-label="Hamsavani home">
          <svg class="mark" viewBox="0 0 28 28" aria-hidden="true"><rect x="3" y="11" width="3.6" height="6" rx="1.8"/><rect x="9" y="6" width="3.6" height="16" rx="1.8"/><rect x="15" y="3" width="3.6" height="22" rx="1.8"/><rect x="21" y="9" width="3.6" height="10" rx="1.8"/></svg>
          <span>Hamsa<b>vani</b></span>
        </a>
      </div>
      <div class="top-controls">
        <div class="levels" role="group" aria-label="Your level">
          <button data-level="beginner">Beginner</button>
          <button data-level="intermediate">Medium</button>
          <button data-level="advanced">Advanced</button>
        </div>
        <div class="topics" role="group" aria-label="Topic">
          <button data-topic="">Anything</button>
          <button data-topic="routine">My day</button>
          <button data-topic="food">Food</button>
          <button data-topic="college">College</button>
          <button data-topic="hobbies">Hobbies</button>
          <button data-topic="travel">Travel</button>
          <button data-topic="movies">Movies</button>
          <button data-topic="future">Future plans</button>
          <button data-topic="family">Family</button>
        </div>
      </div>
    </header>

    <section class="intro" id="empty">
      <div class="intro-copy">
        <h2>Choose your level</h2>
        <div class="levels big" role="group" aria-label="Your level">
          <button data-level="beginner">Beginner</button>
          <button data-level="intermediate">Medium</button>
          <button data-level="advanced">Advanced</button>
        </div>
        <h2>Pick a topic</h2>
        <div class="topics wrap" role="group" aria-label="Topic">
          <button data-topic="">Anything</button>
          <button data-topic="routine">My day</button>
          <button data-topic="food">Food</button>
          <button data-topic="college">College</button>
          <button data-topic="hobbies">Hobbies</button>
          <button data-topic="travel">Travel</button>
          <button data-topic="movies">Movies</button>
          <button data-topic="future">Future plans</button>
          <button data-topic="family">Family</button>
        </div>

        <button type="button" class="guide-link" id="guideBtn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"/></svg>
          <span>Download the free practice guide (PDF)</span>
        </button>

        <div class="try" id="try">
          <p class="try-title">Try saying this today</p>
          <p class="try-text" id="tryText"></p>
          <div class="try-actions">
            <button type="button" class="try-go" id="tryGo">Talk about this</button>
            <button type="button" class="try-next" id="tryNext">Another one</button>
          </div>
        </div>
      </div>
    </section>

    <main class="stage">
      <div id="chat" class="chat" aria-live="polite"></div>
    </main>

    <footer class="dock">
      <div class="dock-inner">
        <p class="hint" id="hint" hidden></p>
        <p class="status" id="status">Ready when you are.</p>
        <div class="controls">
          <button class="side" id="hintBtn" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/></svg>
            <span>Idea</span>
          </button>

          <button class="main-btn" id="micBtn" type="button">
            <svg class="mic-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zM6 11a6 6 0 0 0 12 0M12 17v4"/></svg>
            <span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            <span class="label" id="micLabel">Start conversation</span>
          </button>

          <button class="side" id="pdfBtn" type="button" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"/></svg>
            <span>Sheet <b id="pdfCount"></b></span>
          </button>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
