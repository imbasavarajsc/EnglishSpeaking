---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070b14" />
    <meta name="description" content="Free AI English speaking practice. Talk out loud, hear a reply, and see your mistakes fixed right away." />
    <title>MettleVoice: Free AI English Speaking Practice</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body data-view="home" data-state="idle" data-tutor="Captain Hamsa">
    <header class="top">
      <div class="top-inner">
        <p class="brand" id="brand">
          <svg class="mark" viewBox="0 0 28 28" aria-hidden="true"><rect x="3" y="11" width="3.6" height="6" rx="1.8"/><rect x="9" y="6" width="3.6" height="16" rx="1.8"/><rect x="15" y="3" width="3.6" height="22" rx="1.8"/><rect x="21" y="9" width="3.6" height="10" rx="1.8"/></svg>
          <span>Mettle<b>Voice</b></span>
        </p>
      </div>
      </header>

    <section class="home" id="home">
      <div class="home-copy">
        <h1 class="quote">
          <span class="q-a">It does not matter how slowly you go,</span>
          <span class="q-b">As long as you <em>do not stop.</em></span>
        </h1>
        <svg class="journey" viewBox="0 0 360 76" aria-hidden="true">
          <path id="trail" class="track" d="M3 50 C 32 50, 40 14, 72 14 S 112 62, 142 54 S 172 22, 202 28 S 238 68, 265 58 S 300 10, 356 12" />
          <path class="draw" pathLength="1" d="M3 50 C 32 50, 40 14, 72 14 S 112 62, 142 54 S 172 22, 202 28 S 238 68, 265 58 S 300 10, 356 12" />
          <circle class="dot" r="5.5"><animateMotion dur="9s" repeatCount="indefinite" calcMode="linear" keyPoints="0;1;1" keyTimes="0;0.92;1"><mpath href="#trail" /></animateMotion></circle>
        </svg>
        <p class="points">Speak out loud <b>&middot;</b> Instant corrections <b>&middot;</b> PDF sheet</p>
      </div>
      <div class="home-bar">
        <p class="trust">Free &middot; No sign-in</p>
        <a class="enter" href="/practice.html">
          <span>Get started</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </section>
  </body>
</html>
